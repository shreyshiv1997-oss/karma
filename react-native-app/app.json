{
  "expo": {
    "name": "KARMA",
    "slug": "karma",
    "scheme": "karma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF8",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
